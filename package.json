{
  "name": "timetracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "node scripts/check-config.mjs",
    "deploy": "npm run build && npm run db:remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply timetracker --local",
    "db:remote": "wrangler d1 migrations apply timetracker --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "TZ=Europe/Zurich vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.4",
    "@tanstack/react-query": "^5.101.4",
    "hono": "^4.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.2",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
